# ---------------------------------------------------------------------------
# Cloudflare Worker (server-side only)
# Set as Worker secrets (`npx wrangler secret put NAME`) or, for
# `npx wrangler dev`, copy to .dev.vars. Never compile these into the app.
# ---------------------------------------------------------------------------
NUXT_SUPABASE_SERVICE_ROLE_KEY=
NUXT_GEMINI_API_KEY=
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=
# Already set in wrangler.jsonc "vars":
# NUXT_PUBLIC_SUPABASE_URL=https://wyuxriiwljkcfqayrvpd.supabase.co

# ---------------------------------------------------------------------------
# Flutter build (public values, compiled into the app via --dart-define)
# Set as build environment variables in Cloudflare; build.sh passes them on.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://wyuxriiwljkcfqayrvpd.supabase.co
SUPABASE_ANON_KEY=
